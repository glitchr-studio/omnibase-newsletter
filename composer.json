{
    "name": "omnibase/newsletter",
    "description": "A newsletter for omnibase: subscribers with double opt-in, campaigns written in the back office and sent through Messenger, a monthly digest drafted from the site’s sources.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": "^8.2",
        "doctrine/orm": "^2.15|^3.0",
        "glitchr/omnibase": "3.0.*-dev",
        "omnibase/admin": "dev-main",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "symfony/security-bundle": "^6.0|^7.0|^8.0",
        "symfony/messenger": "^6.0|^7.0|^8.0",
        "symfony/rate-limiter": "^6.0|^7.0|^8.0",
        "symfony/mailer": "^6.0|^7.0|^8.0",
        "symfony/twig-bridge": "^6.0|^7.0|^8.0",
        "symfony/console": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {"Base\\Newsletter\\": "./src"}
    },
    "autoload-dev": {
        "psr-4": {"Base\\Newsletter\\Tests\\": "./tests"}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
