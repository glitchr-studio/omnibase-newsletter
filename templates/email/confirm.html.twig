{#
 # "Confirm your address" (Base\Newsletter\Service\NewsletterMailer::confirm),
 # through omnibase's notifier: its <title> is the mail's subject. Sober and
 # table-based, for every mail client; a host overrides it from
 # templates/bundles/NewsletterBundle/email/confirm.html.twig.
 #}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head><meta charset="utf-8"><title>{{ subject }}</title></head>
<body style="margin:0;background:#f4f4f2;font-family:Georgia,'Times New Roman',serif;color:#1c1c1c;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f2;padding:24px 0;">
<tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;">
    {% if site_title %}
    <tr><td style="padding:22px 28px 0;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#6b6b6b;">{{ site_title }}</td></tr>
    {% endif %}
    <tr><td style="padding:16px 28px 28px;font-size:16px;line-height:1.6;">
        <h1 style="margin:0 0 14px;font-size:22px;font-weight:normal;">{{ '@newsletter.email.confirm.title'|trans({}, null, locale) }}</h1>
        <p style="margin:0 0 20px;">{{ '@newsletter.email.confirm.text'|trans({}, null, locale) }}</p>
        <p style="margin:0 0 24px;"><a href="{{ confirm }}" style="background:#1c1c1c;color:#ffffff;text-decoration:none;padding:12px 22px;border-radius:999px;display:inline-block;font-family:Arial,Helvetica,sans-serif;font-size:15px;">{{ '@newsletter.email.confirm.button'|trans({}, null, locale) }}</a></p>
        <p style="margin:0;font-size:13px;color:#6b6b6b;">{{ '@newsletter.email.confirm.ignore'|trans({}, null, locale) }}</p>
    </td></tr>
    <tr><td style="padding:14px 28px;border-top:1px solid #ececec;font-size:12px;color:#8a8a8a;">
        <a href="{{ home }}" style="color:#8a8a8a;">{{ site_title ?? home|replace({'https://': '', 'http://': ''})|trim('/') }}</a>
    </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
